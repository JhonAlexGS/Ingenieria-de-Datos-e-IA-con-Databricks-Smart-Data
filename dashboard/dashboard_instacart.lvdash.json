{
  "datasets": [
    {
      "name": "92a9e68f",
      "displayName": "Ventas y recompra por departamento",
      "queryLines": [
        "-- Ventas y recompra por departamento\r\n",
        "SELECT departamento, total_productos_vendidos, \r\n",
        "    participacion_pct, tasa_recompra\r\n",
        "FROM catalog_prod.golden.kpi_departamentos\r\n",
        "ORDER BY total_productos_vendidos DESC;"
      ]
    },
    {
      "name": "7accd691",
      "displayName": "Ordenes por dia y hora",
      "queryLines": [
        "-- Ordenes por dia y hora\r\n",
        "SELECT dia_semana_num, dia_semana, hora_dia, total_ordenes\r\n",
        "FROM catalog_prod.golden.actividad_dia_hora\r\n",
        "ORDER BY dia_semana_num, hora_dia;"
      ]
    },
    {
      "name": "43a0bdb7",
      "displayName": "Segmentos de clientes",
      "queryLines": [
        "-- Segmentos de clientes\r\n",
        "SELECT segmento,\r\n",
        "       COUNT(*) AS clientes,\r\n",
        "       ROUND(AVG(promedio_productos_orden), 2)    AS productos_por_orden,\r\n",
        "       ROUND(AVG(promedio_dias_entre_ordenes), 1) AS dias_entre_ordenes,\r\n",
        "       ROUND(AVG(tasa_recompra) * 100, 1)         AS tasa_recompra_pct\r\n",
        "FROM catalog_prod.golden.segmentos_clientes\r\n",
        "GROUP BY segmento\r\n",
        "ORDER BY clientes DESC;"
      ]
    }
  ],
